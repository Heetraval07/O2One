# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
# Set to 1 when the app runs behind one reverse proxy (Nginx, a load balancer), so rate limits see real IPs.
TRUST_PROXY=0

# Public address of the site. Used in the links emailed to the admin (password reset, email change).
PUBLIC_URL=http://localhost:5173

# --- MariaDB -----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=o2one_website
DB_USER=o2one
DB_PASSWORD=change-me
DB_POOL_SIZE=10

# --- Time zone used in enquiry emails and the admin booking list -------------
# Dubai = UTC+4, no daylight saving.
BOOKING_UTC_OFFSET_MINUTES=240
BOOKING_TIMEZONE_LABEL=Dubai time (GST)

# --- Contact form email (required for enquiries to reach you) ----------------
# The contact form emails every enquiry to ENQUIRY_NOTIFY_EMAIL through this SMTP server.
# Without SMTP_HOST and ENQUIRY_NOTIFY_EMAIL the visitor is shown a "couldn't send, try again" message.
# Never commit real values: set them in .env locally (it is git-ignored) and in the host's
# environment variables (e.g. Vercel > Project Settings > Environment Variables) when deployed.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
# For Gmail / Google Workspace this is an app password, not the account password
SMTP_PASSWORD=
MAIL_FROM=O2One Consultants <no-reply@example.com>
# Who at O2One receives the enquiries
ENQUIRY_NOTIFY_EMAIL=

# --- Public site details (built into the frontend; safe to expose) -----------
VITE_CONTACT_EMAIL=priyanka@o2one.ae
VITE_CONTACT_PHONE=+971 54 593 2700
# Digits only, with country code, no + (used for wa.me links)
VITE_WHATSAPP_NUMBER=971545932700
VITE_DUBAI_ADDRESS=Meydan Grandstand, 6th floor, Meydan Road, Nad Al Sheba, Dubai, U.A.E.
VITE_LINKEDIN_URL=https://www.linkedin.com/company/o2one-ae/
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_TWITTER_URL=
