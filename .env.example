# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
# Set to 1 when the app runs behind one reverse proxy (Nginx, a load balancer), so rate limits see real IPs.
TRUST_PROXY=0

# Public address of the site. Used in the links emailed to the admin (password reset, email change).
PUBLIC_URL=http://localhost:5173

# --- MariaDB -----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=o2one_website
DB_USER=o2one
DB_PASSWORD=change-me
DB_POOL_SIZE=10

# --- Health checkup booking slots --------------------------------------------
# Dubai = UTC+4, no daylight saving.
BOOKING_UTC_OFFSET_MINUTES=240
BOOKING_TIMEZONE_LABEL=Dubai time (GST)
# ISO weekdays, 1 = Monday ... 7 = Sunday
BOOKING_DAYS=1,2,3,4,5
# Session start times (local). Each checkup is two hours.
BOOKING_START_TIMES=10:00,14:00,16:00
# Earliest booking is this many days ahead; slots are offered this many days out.
BOOKING_LEAD_DAYS=1
BOOKING_WINDOW_DAYS=21
# Public holidays or days off, YYYY-MM-DD, comma separated
BOOKING_BLOCKED_DATES=

# --- Email (optional) --------------------------------------------------------
# Leave SMTP_HOST empty to turn emails off. Bookings are always saved either way.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=O2One Consultants <no-reply@example.com>
# Who at O2One gets told about new bookings
BOOKING_NOTIFY_EMAIL=

# --- Public site details (built into the frontend; safe to expose) -----------
VITE_CONTACT_EMAIL=hello@example.com
VITE_CONTACT_PHONE=+971 54 593 2700
# Digits only, with country code, no + (used for wa.me links)
VITE_WHATSAPP_NUMBER=971545932700
VITE_DUBAI_ADDRESS=Meydan Grandstand, 6th floor, Meydan Road, Nad Al Sheba, Dubai, U.A.E.
VITE_MUMBAI_ADDRESS=Mumbai, India
VITE_LINKEDIN_URL=
