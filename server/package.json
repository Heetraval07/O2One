{
  "name": "o2one-server",
  "version": "1.0.0",
  "description": "O2One website API (Express + SQLite)",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "db:init": "node scripts/db-init.js",
    "db:seed": "node scripts/db-init.js --seed",
    "db:import-mariadb": "node scripts/import-from-mariadb.js",
    "admin:create": "node scripts/admin.js create",
    "admin:reset": "node scripts/admin.js reset",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "compression": "^1.8.2",
    "dotenv": "^18.0.7",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
